menuconfig LPKG_USING_RT_CARPLAY
    bool "rt-carplay: AirPlay/iAP2 CarPlay receiver"
    default n
    depends on LPKG_USING_MBEDTLS
    help
        Portable CarPlay (wireless iAP2 + AirPlay) receiver core with an
        RT-Thread OS/socket port.  Requires mbedTLS 2.x built with
        MBEDTLS_CHACHA20_C, MBEDTLS_POLY1305_C, MBEDTLS_CHACHAPOLY_C and
        MBEDTLS_HKDF_C; see port/luban-lite/README.md.

if LPKG_USING_RT_CARPLAY

config LPKG_RT_CARPLAY_LOG
    bool "Enable rt-carplay logging"
    default y
    help
        Route RTCP_LOGx() output through rt_kprintf().  Turn off to drop the
        logging strings from the image.

config LPKG_RT_CARPLAY_ED25519
    bool "Vendored software Ed25519 identity"
    default y
    help
        Compile orlp/ed25519 (zlib license, third_party/ed25519) and the
        airplay_ed25519 wrapper.  This is the software signing identity used
        by Pair-Setup / Pair-Verify; without it the application must provide
        its own sign/verify callbacks (for example a hardware-backed key).

config LPKG_RT_CARPLAY_LUBANLITE_WIFI
    bool "Use the Luban-Lite Realtek SoftAP seam"
    default y if AIC_WLAN_REALTEK
    depends on AIC_WLAN_REALTEK
    help
        Bind rtcp_wifi to the Realtek RTL8733BS SoftAP API.  Vendor IE
        injection additionally needs CONFIG_REALTEK_FULL_FNC_MODE.

config LPKG_RT_CARPLAY_LUBANLITE_BT
    bool "Use the Luban-Lite Zephyr Bluetooth RFCOMM transport"
    default y if LPKG_USING_ZEPHYR_BLUETOOTH && LPKG_BT_CLASSIC && LPKG_BT_RFCOMM
    depends on LPKG_USING_ZEPHYR_BLUETOOTH && LPKG_BT_CLASSIC && LPKG_BT_RFCOMM
    help
        Bind the rtcp_bt transport to the SDK Zephyr Classic BR/EDR +
        RFCOMM host, for the wireless iAP2 path.  Needs the RTL8733BS H5
        HCI transport selected in the zephyr-bluetooth package.

config LPKG_RT_CARPLAY_LUBANLITE_MFI
    bool "Use the Luban-Lite I2C MFi 2.0C provider"
    default y if AIC_I2C_DRV
    depends on AIC_I2C_DRV
    help
        Bind struct rtcp_mfi to a 2.0C authentication coprocessor on the
        RT-Thread I2C bus, so the wireless iAP2 session can run the MFi
        certificate/challenge exchange.  The bus name and address are
        board parameters (i2c0/0x6A on demo128-nand-carplay); the register
        engine is core/mfi/mfi2c.c.  Without a working coprocessor the
        session stops after IdentificationInformation.

endif
