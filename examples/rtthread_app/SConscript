# Builds the RT-Thread receiver application together with the rt-carplay
# library.  The integrating SDK application only needs:
#
#     SConscript('<repo>/examples/rtthread_app/SConscript')
#
import os
from building import *

cwd = GetCurrentDir()

# Build the protocol library and ports from the repository root.  When the
# checkout sits under packages/third-party the SDK has already sourced that
# SConscript, so only add it once.
import building
if not any(group.get('name') == 'rt-carplay' for group in building.Projects):
    SConscript(os.path.join(cwd, '..', '..', 'SConscript'))

src = Glob('carplay_app.c')

# The on-board video path (MPP H.264 decoder + DE video layer).  It lives in
# the same group because carplay_app.c composes it under the same symbol.
if GetDepend('RTCARPLAY_VIDEO'):
    src += Glob('video_sink_lubanlite.c')

# Wireless iAP2 over the Zephyr RFCOMM transport (carplay_iap2 command).
if GetDepend('RTCARPLAY_IAP2'):
    src += Glob('iap2_link_lubanlite.c')

group = DefineGroup('rt-carplay-app', src,
                    depend=['LPKG_USING_RT_CARPLAY',
                            'LPKG_RT_CARPLAY_LUBANLITE_WIFI'],
                    CPPPATH=[cwd])

Return('group')
