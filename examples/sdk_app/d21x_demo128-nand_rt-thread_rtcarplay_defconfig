CONFIG_PRJ_DEFCONFIG_FILENAME="d21x_demo128-nand_rt-thread_rtcarplay_defconfig"
CONFIG_PRJ_CHIP="d21x"
CONFIG_PRJ_BOARD="demo128-nand-carplay"
CONFIG_PRJ_KERNEL="rt-thread"
CONFIG_PRJ_APP="rtcarplay"
CONFIG_AIC_USING_FS_IMAGE_0=y
CONFIG_AIC_USING_FS_IMAGE_TYPE_FATFS_FOR_0=y
CONFIG_AIC_FS_IMAGE_DIR_0="rodata/"
CONFIG_AIC_FS_IMAGE_NAME_0="rodata.fatfs"
CONFIG_AIC_USING_FS_IMAGE_1=y
CONFIG_AIC_USING_FS_IMAGE_TYPE_FATFS_FOR_1=y
CONFIG_AIC_FS_IMAGE_DIR_1="data/"
CONFIG_AIC_FS_IMAGE_NAME_1="data.fatfs"
CONFIG_LPKG_USING_LVGL=y
CONFIG_LVGL_V_9=y
CONFIG_LV_CACHE_IMG_NUM=15
CONFIG_AIC_USING_UART0=y
CONFIG_AIC_USING_UART1=y
CONFIG_AIC_USING_UART7=y
CONFIG_AIC_DEV_UART7_BAUDRATE=1500000
CONFIG_AIC_DEV_UART7_MODE_RS232_AUTO_FLOW_CTRL=y
CONFIG_AIC_UART7_DMA_ENABLE_FLAG=y
CONFIG_AIC_USING_I2C0=y
CONFIG_AIC_USING_I2C3=y
CONFIG_AIC_DEV_I2C0_SPEED=100000
CONFIG_AIC_USING_CAN0=y
CONFIG_AIC_USING_CAN1=y
CONFIG_AIC_USING_USB0=y
CONFIG_AIC_USING_USB0_HOST=y
# CONFIG_AIC_USING_USB1 is not set
CONFIG_AIC_USING_QSPI0=y
CONFIG_AIC_QSPI0_DEVICE_SPINAND=y
CONFIG_AIC_USING_SDMC2=y
CONFIG_AIC_SDMC2_IS_SDIO=y
CONFIG_AIC_WIRELESS_LAN=y
CONFIG_AIC_WIRELESS_PWR_GPIO="PD.1"
CONFIG_AIC_WIRELESS_BT_PWR_GPIO="PD.3"
CONFIG_AIC_WIFI_SDMC_ID=2
# Bluetooth (RTL8733BS HCI H5 on uart7) for the wireless iAP2 path.
CONFIG_LPKG_USING_ZEPHYR_BLUETOOTH=y
CONFIG_LPKG_ZEPHYR_BLUETOOTH_CHIPSET_RTL8733=y
CONFIG_LPKG_BT_UART="uart7"
# CONFIG_LPKG_BT_H4 is not set
CONFIG_LPKG_BT_H5=y
CONFIG_LPKG_BT_CLASSIC=y
# The SDK's BT_ASSERT path calls k_oops() without fatal_types.h, which
# does not build with LPKG_BT_CLASSIC in this SDK revision; use the kernel
# assert macro (compiled out when CONFIG_ASSERT is off) instead.
# CONFIG_LPKG_BT_ASSERT is not set
CONFIG_LPKG_BT_RFCOMM=y
CONFIG_LPKG_BT_BUF_ACL_RX_SIZE=1024
CONFIG_LPKG_BT_RFCOMM_L2CAP_MTU=1011
CONFIG_LPKG_BT_DEVICE_NAME_DYNAMIC=y
CONFIG_LPKG_BT_DEVICE_NAME="rt-carplay"
CONFIG_LPKG_BT_DEVICE_NAME_MAX=32
CONFIG_LPKG_RT_CARPLAY_LUBANLITE_BT=y
CONFIG_RTCARPLAY_BT=y
CONFIG_RTCARPLAY_IAP2=y
# MFi 2.0C coprocessor: ZABlue's HW_SECRUITY_I2C_ID/ADDR on this board.
CONFIG_LPKG_RT_CARPLAY_LUBANLITE_MFI=y
CONFIG_RTCARPLAY_MFI=y
CONFIG_RTCARPLAY_MFI_I2C_BUS="i2c0"
CONFIG_RTCARPLAY_MFI_I2C_ADDR=0x6A
CONFIG_AIC_USING_TSEN=y
CONFIG_AIC_DISP_LVDS=y
CONFIG_AIC_PAN_DISPLAY=y
CONFIG_AIC_DISP_BLACK_SCREEN=y
CONFIG_AIC_PANEL_ENABLE_GPIO="PC.7"
CONFIG_AIC_USING_AUDIO=y
CONFIG_AIC_AUDIO_EN_PIN_LOW=y
CONFIG_AIC_AUDIO_SPK_1=y
# AirPlay audio -> RT-Thread "sound0" replay (rt-carplay audio sink).
CONFIG_RTCARPLAY_AUDIO=y
# Touch panel (GT911) -> CarPlay HID touch reports.
CONFIG_RTCARPLAY_TOUCH_PANEL=y
# Native panel mode: must match AIC_SCREEN_REAL_X/Y_RESOLUTION (1024x600).
CONFIG_RTCARPLAY_SCREEN_WIDTH=1024
CONFIG_RTCARPLAY_SCREEN_HEIGHT=600
CONFIG_RTCARPLAY_ROTATION=0
CONFIG_AIC_USING_DMA=y
CONFIG_AIC_USING_WRI=y
CONFIG_AIC_USING_RTC=y
CONFIG_AIC_USING_WDT=y
CONFIG_AIC_DRAM_CMA_SIZE=0x2000000
CONFIG_AIC_INTERRUPTSTACK_SIZE=0x4000
CONFIG_AIC_USING_SID=y
CONFIG_AIC_USING_CE=y
CONFIG_IDLE_THREAD_STACK_SIZE=16384
CONFIG_RT_TIMER_THREAD_STACK_SIZE=16384
# CONFIG_RT_KSERVICE_USING_STDLIB is not set
# CONFIG_RT_KPRINTF_USING_LONGLONG is not set
# CONFIG_RT_DEBUG is not set
CONFIG_RT_MEMHEAP_BSET_MODE=y
CONFIG_RT_USING_MEMHEAP_AS_HEAP=y
# CONFIG_RT_USING_MEMHEAP_AUTO_BINDING is not set
CONFIG_RT_USING_DEVICE_OPS=y
CONFIG_RT_CONSOLE_DEVICE_NAME="uart0"
# Stack sizes follow the board-verified ZALink profile: main/finsh run
# carplay_start (mbedTLS, Wi-Fi and file setup) and the SDIO/MMC threads
# serve the RTL8733BS SDIO bus.
CONFIG_RT_MAIN_THREAD_STACK_SIZE=16384
CONFIG_RT_USING_LEGACY=y
CONFIG_FINSH_USING_WORD_OPERATION=y
CONFIG_FINSH_USING_FUNC_EXT=y
CONFIG_FINSH_THREAD_STACK_SIZE=32768
CONFIG_DFS_FILESYSTEMS_MAX=8
CONFIG_RT_USING_DFS_MNTTABLE=y
CONFIG_RT_USING_DFS_ELMFAT=y
CONFIG_RT_DFS_ELM_LFN_UNICODE_2=y
CONFIG_RT_DFS_ELM_USE_EXFAT=y
CONFIG_RT_DFS_ELM_DRIVES=4
CONFIG_RT_USING_DFS_DEVFS=y
CONFIG_RT_USING_DFS_ROMFS=y
CONFIG_RT_I2C_DEBUG=y
# CONFIG_RT_USING_I2C_BITOPS is not set
CONFIG_RT_USING_ADC=y
CONFIG_RT_USING_PM=y
CONFIG_PM_USING_CUSTOM_CONFIG=y
CONFIG_PM_ENABLE_SUSPEND_SLEEP_MODE=y
CONFIG_PM_ENABLE_THRESHOLD_SLEEP_MODE=y
CONFIG_RT_SDIO_STACK_SIZE=16384
CONFIG_RT_MMCSD_STACK_SIZE=16384
CONFIG_RT_USING_TOUCH=y
CONFIG_RT_TOUCH_PIN_IRQ=y
CONFIG_RT_HWCRYPTO_USING_AES=y
CONFIG_RT_HWCRYPTO_USING_AES_CBC=y
CONFIG_RT_HWCRYPTO_USING_MD5=y
CONFIG_RT_HWCRYPTO_USING_SHA1=y
CONFIG_RT_HWCRYPTO_USING_SHA2=y
CONFIG_RT_HWCRYPTO_USING_SHA2_224=y
CONFIG_RT_HWCRYPTO_USING_SHA2_384=y
CONFIG_RT_HWCRYPTO_USING_SHA2_512=y
CONFIG_RT_USING_WIFI=y
CONFIG_RT_WLAN_PROT_LWIP_PBUF_FORCE=y
# Network stack tuned to the board-verified ZALink profile (same D213 +
# RTL8733BS): more RX pbufs and no separate lwIP rx/tx threads for Wi-Fi
# bursts, RX thread above the TCP thread, larger stacks.
CONFIG_RT_LWIP_MEM_ALIGNMENT=4
CONFIG_RT_LWIP_PBUF_NUM=256
CONFIG_RT_LWIP_REASSEMBLY_FRAG=y
CONFIG_LWIP_NO_RX_THREAD=y
CONFIG_LWIP_NO_TX_THREAD=y
CONFIG_RT_LWIP_TCPTHREAD_STACKSIZE=16384
CONFIG_RT_LWIP_ETHTHREAD_PRIORITY=3
CONFIG_RT_LWIP_ETHTHREAD_STACKSIZE=16384
CONFIG_RT_WLAN_WORKQUEUE_THREAD_SIZE=4096
CONFIG_RT_USING_POSIX_FS=y
CONFIG_RT_USING_NETDEV=y
CONFIG_RT_LWIP_NETIF_LOOPBACK=y
CONFIG_RT_USING_ULOG=y
CONFIG_ULOG_OUTPUT_LVL_I=y
CONFIG_ULOG_TIME_USING_TIMESTAMP=y
CONFIG_ULOG_USING_FILTER=y
CONFIG_LPKG_USING_CPU_USAGE=y
CONFIG_LPKG_USING_CHERRYUSB=y
CONFIG_LPKG_CHERRYUSB_HOST=y
CONFIG_LPKG_CHERRYUSB_HOST_MSC=y
CONFIG_LPKG_USING_MBEDTLS=y
CONFIG_AIC_MPP_PLAYER_INTERFACE=y
CONFIG_LPKG_USING_AIC_AUTHORIZATION=y
CONFIG_AIC_GPIO_IRQ_DRV_EN=y
CONFIG_AIC_NFTL_SUPPORT=y
CONFIG_AIC_NAND_REFRESH_SUPPORT=y
CONFIG_AIC_USING_TOUCH=y
CONFIG_AIC_DMA_DRV_TEST=y
CONFIG_AIC_RTC_DRV_TEST=y
CONFIG_AIC_DISPLAY_TEST=y
CONFIG_AIC_WLAN_REALTEK=y
CONFIG_REALTEK_FULL_FNC_MODE=y
CONFIG_RT_USING_SYSTEM_WORKQUEUE=y
CONFIG_LWIP_USING_DHCPD=y
